<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Greeting">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit_light</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Clock">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Outfit's ascent is ~1em above tall-ish digits; pull the clock up to the greeting. -->
        <item name="android:layout_marginTop">-14dp</item>
        <item name="android:fontFamily">@font/outfit_thin</item>
        <item name="android:textSize">86sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DateLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit_light</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">-6dp</item>
    </style>

    <style name="HeroTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">680dp</item>
        <item name="android:fontFamily">@font/outfit_extralight</item>
        <item name="android:textSize">46sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">17dp</item>
    </style>

    <style name="PillRound">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/pill</item>
    </style>

    <style name="PillIcon">
        <item name="android:layout_width">17dp</item>
        <item name="android:layout_height">17dp</item>
        <item name="android:tint">#E6FFFFFF</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="PillText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
